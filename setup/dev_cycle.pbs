#!/bin/bash
#PBS -N scprofile_cycle
#PBS -q super
#PBS -l select=1:ncpus=64:mem=400gb
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o logs/

# ONE TEST-FIX CYCLE of the host, against a real object, as a batch job.
#
#   qsub -v PHASE=build,TOOL=...,PY=...,PREFIX=...,OBJ=...,DES=...,REFS=...,\
#           INSTALL=decoupler,KERNELS=decoupler,silhouette,ORGANISM=mouse,ASSAY=nucleus \
#        setup/dev_cycle.pbs
#
# `LABEL=<obs column>` chooses which annotation to profile, passed through as `--label-key`.
# It reaches `plan` and `run` alike, because the two must be given the same object description or
# the plan describes a different grouping from the one that runs. WITHOUT THIS the variable was
# accepted on the qsub line and silently dropped - a run asked for a forced label column and
# profiled the default one, with nothing in its output saying so.
#
# `ALL=1` runs every discovered plugin instead of `KERNELS`. `SEARCH=<dir>` is handed to both
# `plan` and `run` as `--search`, for inputs that are not in the object - the two must be given
# the same leads or the plan can name a directory the run never looks in.
#
# `INSTALL` may name several plugins; each builds the ENVIRONMENT IT RESOLVES TO, so one name per
# resolved group is enough and naming every plugin is harmless. `CORES` sets the budget
# independently of `NCPUS`: the budget decides how many instances run AT ONCE as well as the share
# each is given, and a wave of 35 instances on a big node is bounded by memory, not by cores.
# Override the resource request at submit time - `qsub -l select=... -l walltime=...` - rather than
# editing this file for one cycle.
#
# ESTIMATE HIGH. STANDING INSTRUCTION FROM THE PI, 2026-08-23. The two errors are not
# symmetric: over-requesting costs queue time and some idle capacity, and under-requesting gets
# the job killed - usually late, with nothing kept. `super` is used rather than `long` because
# its memory ceiling is 400 GB against 200, and memory is what kills. PBS 677891 died at 260 GB
# against a 200 GB request after 4h25m; PBS 679143 survived at 188.8 GB of 200, which is a 6%
# margin and was luck rather than design.
#
# Cores are chosen differently from memory ON PURPOSE: 64 rather than the queue's 250, because
# an over-large core request delays SCHEDULING and cores do not kill a job - they only make it
# slower. Memory and walltime are the two that end a run, so those take the ceiling.
#
# THE DEFAULTS WERE PREVIOUSLY THE `long` QUEUE'S CEILING (50 cores, 200 GB). The budget
# is what the allocator divides, so requesting half the queue caps every plugin's share at half -
# and the expensive plugins are exactly the ones that scale. Leave `CORES` unset unless you mean to
# run below the allocation: it defaults to `NCPUS`, and a budget smaller than the request is the
# one mistake here that looks like nothing. Measured on PBS 677891 - a 24-core request carrying a
# 12-core budget ran ten GRNBoost2 fits, each declaring 16 cores, on one core each.
#
# NOTHING HERE NAMES A PROJECT. Every path, kernel, organism and assay arrives through -v, because
# a job script in this repository that hard-coded one dataset would be the same overfitting the
# portability test exists to stop - and the next person's cluster is not this one.
#
# FOUR PHASES, RUN AS SEPARATE JOBS.
#
#   build    doctor -> install --dry-run -> install.  Builds the RESOLVED environment, which may
#            be shared, and proves it with every member's selftest.
#   plan     plan --audit --report and nothing else. Reads the object, runs no plugin and
#            touches no environment - for "what WOULD run, and how".
#   run      validate -> selftest -> plan --audit --report -> run.  Touches no environment.
#   repair   breaks an environment on purpose and watches the run -> build edge close.
#
# They are separate jobs because a rebuild can eat the walltime of everything after it, and a
# phase that did not run looks exactly like a phase that found nothing.
#
# ONE JOB AT A TIME AGAINST ONE PREFIX. Two concurrent jobs sharing --prefix have already cost
# this project a day: a --force rebuild in one deleted the environment the other's selftest was
# reading, and it was written up as a tool defect before anybody noticed.

set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p logs

: "${PHASE:?pass -v PHASE=build|plan|run|repair}"
: "${TOOL:?pass -v TOOL=<path to the scProfile checkout>}"
: "${PY:?pass -v PY=<host interpreter, one with anndata>}"
: "${PREFIX:?pass -v PREFIX=<dir the environments are built in>}"

# --- environment ----------------------------------------------------------
# A conda-family manager has to be on PATH for the builder to have a route at all; `machine()`
# reports which one it found, and refuses with the alternatives if it found none.
module load "${CONDA_MODULE:-anaconda3/3.0.0}" 2>/dev/null || true
# A FASTER SOLVER IF THE SITE HAS ONE. `machine()` prefers micromamba, then mamba, then conda,
# and reports which it found - but it can only find what is on PATH, and a site whose only module
# is a classic anaconda3 has the slowest of the three. Point MANAGER_PATH at a directory holding
# micromamba or mamba and it is used instead; nothing else changes, because all three build the
# same prefix. A 50-package conda-forge + bioconda solve is minutes with one and can be hours
# with the other.
# An `if`, not `[ ... ] && ...`: under `set -e` a bare test that FAILS is the last command of
# the statement and ends the job - silently, before the live log is even opened, so a run with
# MANAGER_PATH unset would have looked exactly like a job that produced nothing.
if [ -n "${MANAGER_PATH:-}" ]; then export PATH="${MANAGER_PATH}:$PATH"; fi

# ---- RUN FROM A SNAPSHOT, NOT FROM THE LIVE CHECKOUT ---------------------------------------
# The code is read at EVERY subprocess launch, not once at the start. A three-hour run spawns
# instances across three hours, so a `git pull` into $TOOL at hour one is picked up by everything
# launched after it: the run uses two versions and reports one, because the banner below records
# the commit once. Both versions are correct on their own - it is the MIXTURE that is wrong, so
# no test catches it and the report names a commit that never produced those results in full.
#
# A snapshot removes the race rather than asking anyone to remember. It is a few MB of Python,
# copied once, and it also means the run directory holds exactly the code that produced it.
#
# SNAPSHOT=0 opts out, for interactively iterating on the tool against a running job.
if [ "${SNAPSHOT:-1}" = "1" ]; then
  _SNAP="${OUT:-$PWD}/.tool"
  rm -rf "$_SNAP"; mkdir -p "$_SNAP"
  # THE WHOLE TOOL, NOT A LIST OF ITS PARTS. This copied `scprofile kernels tests HEAD.txt`,
  # and three checks that read a file from elsewhere in the tree - `setup/dev_cycle.pbs`,
  # `docs/EXECUTION.md`, `README.md` - raised FileNotFoundError against the snapshot. That is
  # not a failing check but an ABORT, so each one silently deleted every check after it, in
  # every job.
  #
  # It was first fixed by ADDING `setup` and `docs` to the list, which fixed the two aborts
  # that had been seen and left the third to surface the moment they stopped firing first. A
  # list of parts is a subset somebody chose, and the part left out is invisible until
  # something reads it - so the enumeration is the defect, not its contents.
  #
  # `.git` is excluded because it is large and a compute node has no git anyway; `__pycache__`
  # because a `.pyc` is written by RUNNING the code, not by changing it, and the fingerprint
  # check already excludes it for that reason.
  tar -C "$TOOL" --exclude=.git --exclude=__pycache__ -cf - . | tar -C "$_SNAP" -xf -
  # THE COMMIT IS READ FROM `.git`, NOT FROM THE FILE BESIDE IT. `HEAD.txt` is untracked, so
  # nothing updates it when the checkout moves: a run of new code reported itself as the commit
  # that happened to be current the last time somebody wrote that file by hand. It is the same
  # stale-stamp failure the layout notes already record, and it is worse than an absent version,
  # because a run labelled with the wrong commit is compared against the wrong code.
  #
  # `git` is absent on a compute node, so this reads the plumbing directly - `.git/HEAD` is
  # either a sha or a `ref:` line naming a file that holds one, and a ref that has been packed
  # lives in `packed-refs` instead. Whatever is found overwrites the copied HEAD.txt; if none is
  # (a tarball deploy with no `.git`), the copied file stands and is the best available.
  # EVERY READ ENDS IN `|| true`, BECAUSE `set -e` IS ON. A `$(cat missing-file)` carries the
  # command's exit status into the assignment, so the first absent ref would not have produced
  # an unknown version - it would have KILLED THE JOB, at the snapshot step, before any work.
  # A checkout whose refs are packed has no `refs/heads/<branch>` file at all, so that is the
  # ordinary case rather than a corner one.
  _H=$(cat "$TOOL/.git/HEAD" 2>/dev/null || true)
  _SHA=""
  case "$_H" in
    ref:*) _R="${_H#ref: }"
           _SHA=$(cat "$TOOL/.git/$_R" 2>/dev/null || true)
           [ -n "$_SHA" ] || _SHA=$(awk -v r="$_R" '$2==r{print $1}' "$TOOL/.git/packed-refs" 2>/dev/null || true) ;;
    *)     _SHA="$_H" ;;
  esac
  [ -n "$_SHA" ] && printf '%s\n' "$_SHA" > "$_SNAP/HEAD.txt"
  TOOL="$_SNAP"
  # HELD, NOT ECHOED. stdout is not attached to the live log until further down, so echoing here
  # sent the one line that says the run is isolated to the PBS job file - which is written at
  # exit, and is not where anyone looks while a run is going.
  _SNAP_MSG="snapshot : running from $_SNAP (a pull into the live checkout cannot reach this run)"
fi

export PYTHONPATH="$TOOL"
export MPLCONFIGDIR="$PWD/.mpl"
# A plugin supplied from OUTSIDE the shipped set, to test the FORMAT rather than the tool.
export SCPROFILE_KERNELS="${EXTRA_KERNELS:-$TOOL/tests/smoke/plugins}"
# --------------------------------------------------------------------------

# UNBUFFERED, or the live log below is a 0-byte file for the whole run. python block-buffers its
# stdout when it is not a terminal, so a job that is working looks exactly like a job that is hung.
export PYTHONUNBUFFERED=1

# For THIS process - the host, which reads a multi-GB object. Each plugin gets its own share set
# by the runner from `in.json`, so what is exported here does not reach them: a job script handing
# the node's core count to every plugin it launches is how a wave comes to run the node's worth of
# BLAS threads per instance.
export OMP_NUM_THREADS="${NCPUS:-1}"
export MKL_NUM_THREADS="${NCPUS:-1}"

# STREAM TO SHARED STORAGE AS WE GO. PBS copies its -o file only when the job EXITS, so a build
# that is still running - or one that was killed - leaves nothing to read, and "no output" then
# looks exactly like "never started". Never /tmp: it is node-local, so a log written there is
# invisible from the machine you are sitting on.
# ONE LOG PER RUN. This was `logs/live_<phase>.log`, opened with `tee -a`, so every run of a
# phase APPENDED to the same file — and the file therefore carried several jobs, on several
# nodes, at several commits, with one header at the top naming only the first of them.
#
# It cost a healthy run. Reading that file's tail showed the current job; grepping it by line
# number showed YESTERDAY's, and the two are indistinguishable inside one file: a job id in the
# header, no job id on any other line. A run was diagnosed as failing on environment resolution,
# and killed, on evidence that belonged to a job from the previous afternoon. Nothing about the
# stale half looked stale — which is the whole of the problem, and exactly what rule six says
# about an artifact older than the data it appears to describe.
#
# The job id is in the name now, so a stale log cannot be mistaken for this one, and `-a` is
# kept only so a requeued job appends to its own file rather than truncating it.
LIVE="${LIVE_LOG:-$PWD/logs/live_${PHASE}_${PBS_JOBID%%.*}.log}"
exec > >(tee -a "$LIVE") 2>&1
# now that stdout reaches the live log, say what was decided before it did
[ -n "${_SNAP_MSG:-}" ] && echo "$_SNAP_MSG"
echo "live log : $LIVE"

echo "job      : ${PBS_JOBID:-none}"
echo "node     : $(hostname)"
echo "phase    : ${PHASE}"
echo "tool     : $(cut -c1-7 "$TOOL/HEAD.txt" 2>/dev/null || echo unknown)"
echo "manager  : $(command -v micromamba || command -v mamba || command -v conda || echo NONE)"
echo "started  : $(date)"

# `plan`, `validate` and `selftest` RETURN NON-ZERO WHEN THEY HAVE SOMETHING TO SAY. That is a
# result, not a crash, and under `set -e` it would end the job on a working feature.
say() { echo; echo "########## $* ##########"; }

# WHETHER THIS RUN FINISHED, WRITTEN INTO THE RUN ITSELF. A directory of outputs looks the
# same whether the job walked to the end or was killed at hour eleven of a twelve-hour walltime,
# and the difference is not recoverable afterwards: the scheduler's record ages out, and a
# half-written run has figures, tables and a report in it exactly like a whole one. Anything
# reading these directories later - a reuse layer deciding what to adopt, a station deciding
# whether a defect is real - is then reading partial runs as though they were complete.
#
# The trap covers every exit, not just the last line, because the ways a job ends without
# reaching the last line are the ones that matter. `SEALED.txt` on a clean exit, `FAILED.txt`
# carrying the status on any other, and both name the phase so a build that dies is not
# mistaken for a run that dies.
#
# It is a RECORD, never a gate: nothing here refuses, and a run that fails still keeps every
# artifact it managed to write, for exactly the reason the review block above is not gated.
# A SEAL IS WRITTEN ON TWO CONDITIONS, NOT ONE: the exit status must be zero AND the script must
# have reached its last line and said so. `$?` alone is not enough, and testing it alone produced
# a SEAL on a job that had FAILED - `set -e` does not apply to a command inside an `&&` list, so
# a failure there let execution continue and the trap read the status of whatever ran next. A
# false FAILED costs a re-run; a false SEALED tells everything downstream that a partial run is
# complete, which is the thing this trap exists to prevent. So the two disagree only in the safe
# direction: anything that did not reach the end is FAILED, whatever its status says.
_DONE=""
_seal() {
  _rc=$?
  [ -n "$_DONE" ] || _rc=$(( _rc == 0 ? 99 : _rc ))
  if [ -n "${OUT:-}" ] && [ -d "${OUT:-}" ]; then
    if [ "$_rc" -eq 0 ]; then
      { echo "phase    : ${PHASE}"
        echo "job      : ${PBS_JOBID:-none}"
        echo "tool     : $(cut -c1-40 "$TOOL/HEAD.txt" 2>/dev/null || echo unknown)"
        echo "finished : $(date -u +%Y-%m-%dT%H:%M:%SZ)"
      } > "$OUT/SEALED.txt"
    else
      { echo "phase    : ${PHASE}"
        echo "job      : ${PBS_JOBID:-none}"
        echo "exit     : $_rc$([ "$_rc" -eq 99 ] && echo "  (the script did not reach its last line; 99 is this trap's own code for that)")"
        echo "stopped  : $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "note     : this run did NOT reach the end of its job script. Its outputs are"
        echo "           whatever had been written by then and may be partial."
      } > "$OUT/FAILED.txt"
    fi
  fi
  exit $_rc
}
trap _seal EXIT
trap 'exit 143' TERM     # a walltime kill runs the EXIT trap through this, so it is recorded
# REGISTERED HERE, BEFORE ANY WORK, AND NOT AT THE END OF THE FILE. A trap installed after the
# work covers only the exit it was already going to reach - which is the one case that needed no
# trap. The function reads `$OUT` when it FIRES, so a job that dies before `OUT` is set writes
# nothing, which is correct: there is no run directory to seal yet.

case "${PHASE}" in

build)
  : "${INSTALL:?pass -v INSTALL=<kernel whose environment to build>}"
  say "1. WHAT THE BUILDER RESOLVED"
  $PY -m scprofile.cli doctor --prefix "$PREFIX" || echo "  doctor exit $?"

  say "2. WHAT WOULD BE BUILT, AND FOR WHOM"
  # Resolve and report; build nothing. The resolver proves the DECLARED constraints do not
  # contradict each other. Whether their transitive closure installs is a different claim.
  $PY -m scprofile.cli install "$INSTALL" --prefix "$PREFIX" --dry-run \
      || echo "  install --dry-run exit $?"

  say "3. BUILD IT, AND PROVE IT FOR EVERY MEMBER"
  $PY -m scprofile.cli install "$INSTALL" --prefix "$PREFIX" ${FORCE:+--force} \
      || echo "  install exit $?"

  say "4. WHERE EACH PLUGIN'S INTERPRETER NOW IS"
  $PY -m scprofile.cli doctor --prefix "$PREFIX" || echo "  doctor exit $?"
  ;;

plan)
  # PLAN ONLY. Reads the object, runs nothing, touches no environment - the phase to use when the
  # question is "what WOULD run and how", which is a question people ask far more often than they
  # run a profile. It is still a PBS job and not a login-node command, because it reads a matrix.
  : "${OBJ:?pass -v OBJ=<h5ad>}"
  OUT="${OUT:-$PWD/out}"
  mkdir -p "$OUT"
  say "PLAN, AUDITED, WITH ITS REPORT — over EVERY plugin"
  $PY -m scprofile.cli plan --h5ad "$OBJ" ${DES:+--design "$DES"} \
      ${ORGANISM:+--organism "$ORGANISM"} ${ASSAY:+--assay "$ASSAY"} \
      ${LABEL:+--label-key "$LABEL"} \
      --prefix "$PREFIX" ${REFS:+--references "$REFS"} ${SEARCH:+--search "$SEARCH"} \
      --audit --report "$OUT" || echo "  plan exit $?"
  ;;

run)
  : "${OBJ:?pass -v OBJ=<h5ad>}"
  OUT="${OUT:-$PWD/out}"
  # EVERY PLUGIN, or a named subset. `-v` splits its value on commas, so a list cannot be passed
  # through it at all without escaping - and `--all` is what a user running a whole profiling
  # layer types anyway. KERNELS stays required for the RESTRICTED audit below, which exists to
  # prove that auditing a subset is a legitimate invocation.
  if [ -n "${ALL:-}" ]; then SEL=(--all); else
    : "${KERNELS:?pass -v KERNELS=<one plugin>, or ALL=1}"
    SEL=(--kernel "$KERNELS")
  fi

  say "0. THE SUITES, WHERE THE ARRAYS ARE"
  # A maintainer's workstation may have no numpy, pandas or anndata at all - this project's does
  # not - so a check that needs them is skipped there and SAYS it was skipped. Running the same
  # suites with the host interpreter is where those checks actually execute; seven suites green
  # on a machine that cannot import an array is a weaker statement than it looks.
  # CAPTURE, THEN PRINT. `$PY "$t" | tail | sed` in the failing branch is a PIPELINE, and under
  # `set -o pipefail` its status is the failing python's - so the `if` returns non-zero, and with
  # `set -e` the job ends on the first failing suite instead of reporting all seven. That is the
  # exact trap the header of this file warns about, introduced by the block that was added to
  # report suite failures.
  for t in "$TOOL"/tests/test_*.py; do
    if out=$($PY "$t" 2>&1); then echo "  ok   $(basename "$t")"
    else echo "  FAIL $(basename "$t")"; echo "$out" | tail -25 | sed 's/^/       /'; fi
  done

  say "1. DECLARE"
  $PY -m scprofile.cli validate ${REFS:+--references "$REFS"} || echo "  validate exit $?"

  say "2. SELFTEST — every environment, against what is installed HERE"
  $PY -m scprofile.cli selftest --prefix "$PREFIX" || echo "  selftest exit $?"

  say "3. PLAN, AUDITED, WITH ITS REPORT — over EVERY plugin"
  $PY -m scprofile.cli plan --h5ad "$OBJ" ${DES:+--design "$DES"} \
      ${ORGANISM:+--organism "$ORGANISM"} ${ASSAY:+--assay "$ASSAY"} \
      ${LABEL:+--label-key "$LABEL"} \
      --prefix "$PREFIX" ${REFS:+--references "$REFS"} ${SEARCH:+--search "$SEARCH"} \
      --audit --report "$OUT" || echo "  plan exit $?"

  say "3b. THE SAME PLAN, RESTRICTED — the audit is over what was ASKED FOR"
  # `plan --kernel a,b --audit` used to report an ERROR for every plugin left out, so a restricted
  # plan could not be audited at all. No --report here: the artifact is the full plan above.
  $PY -m scprofile.cli plan --h5ad "$OBJ" ${DES:+--design "$DES"} \
      ${ORGANISM:+--organism "$ORGANISM"} ${ASSAY:+--assay "$ASSAY"} \
      ${LABEL:+--label-key "$LABEL"} \
      --prefix "$PREFIX" ${REFS:+--references "$REFS"} \
      --kernel "${KERNELS:-$(ls "$TOOL/kernels" | head -1 | sed 's/\.py$//')}" --audit 2>&1 \
      | grep -E "AUDIT|checked:|error\(s\)|ERROR|WARN" \
      || echo "  plan(restricted) exit $?"

  say "4. RUN"
  $PY -m scprofile.cli run --h5ad "$OBJ" --out "$OUT" \
      ${DES:+--design "$DES"} ${ORGANISM:+--organism "$ORGANISM"} \
      ${ASSAY:+--assay "$ASSAY"} "${SEL[@]}" \
      --prefix "$PREFIX" ${REFS:+--references "$REFS"} ${SEARCH:+--search "$SEARCH"} \
      --cores "${CORES:-${NCPUS:-4}}" --timeout "${TIMEOUT:-7200}" || echo "  run exit $?"

  say "5. WHAT LANDED"
  [ -d "$OUT" ] && ( cd "$OUT" && find . -type f \( -name '*.csv' -o -name '*.json' \
      -o -name '*.md' -o -name '*.html' \) | sort | sed 's/^/    /' ) || echo "    nothing"

  say "6. WHAT THE RUN LEARNED ABOUT THE TOOLING"
  [ -f "$OUT/report.json" ] && $PY -c "
import json,sys
d=json.load(open(sys.argv[1]))
print('    ran      :',d.get('ran'))
print('    repaired :',d.get('repaired'))
print('    object   :',d.get('object'))
for x in (d.get('diagnoses') or []): print('    [%s] %s'%(x['layer'],x['why'][:200]))
" "$OUT/report.json" || echo "    no report.json"
  ;;

repair)
  # THE run -> build EDGE, watched end to end. A package the plugin imports is removed from the
  # environment it resolves to; the run must diagnose that as [environment], rebuild, retry ONCE,
  # recover, and REPORT the drift rather than swallowing it.
  : "${OBJ:?pass -v OBJ=<h5ad>}"
  : "${KERNELS:?pass -v KERNELS=<the plugin to break>}"
  : "${BREAK:?pass -v BREAK=<import name to remove from its environment>}"
  OUT="${OUT:-$PWD/out_repair}"

  say "1. WHERE ${KERNELS} RESOLVES TO"
  ENVDIR=$($PY - "$TOOL" "$KERNELS" "$PREFIX" <<'PYEOF'
import sys
sys.path.insert(0, sys.argv[1])
from scprofile.kernels import discover
from scprofile import runner
k = discover()[sys.argv[2]]
exe, why = runner.interpreter(k, sys.argv[3])
print(exe or "")
print(why, file=sys.stderr)
PYEOF
)
  echo "  interpreter: ${ENVDIR}"

  say "2. BREAK IT ON PURPOSE"
  "${ENVDIR}" -m pip uninstall -y "$BREAK" || echo "  uninstall exit $?"

  say "3. RUN, AND WATCH THE LOOP CLOSE"
  $PY -m scprofile.cli run --h5ad "$OBJ" --out "$OUT" \
      ${DES:+--design "$DES"} ${ORGANISM:+--organism "$ORGANISM"} \
      ${ASSAY:+--assay "$ASSAY"} --kernel "$KERNELS" \
      --prefix "$PREFIX" ${REFS:+--references "$REFS"} \
      --cores "${NCPUS:-4}" --timeout "${TIMEOUT:-7200}" || echo "  run exit $?"

  say "4. WAS THE DRIFT REPORTED, OR SWALLOWED"
  [ -f "$OUT/report.json" ] && $PY -c "
import json,sys
d=json.load(open(sys.argv[1]))
print('    repaired :',d.get('repaired'))
for x in (d.get('diagnoses') or []): print('    [%s] %s'%(x['layer'],x['why'][:200]))
" "$OUT/report.json" || echo "    no report.json"
  ;;

*)
  echo "unknown PHASE ${PHASE}; one of build, plan, run, repair" >&2
  exit 2
  ;;
esac

echo
# THE EXIT STANDARD, ON WHAT THIS RUN JUST WROTE. A run that produces a report nobody can read
# has not finished, and the only place that is visible is the report itself.
if [ -d "${OUT:-}/report" ]; then
  echo
  echo "########## 7. THE EXIT STANDARD ##########"
  "$PY" -m scprofile.cli standard --out "$OUT" || echo "  standard exit $?"

  # WHICH FIGURES NOBODY HAS LOOKED AT. Printed on every cycle, NOT gated - a gate that fires
  # on correct behaviour gets switched off, and an automated cycle has nobody at the screen to
  # satisfy it. What it must not do is let the set stay invisible: every figure defect found in
  # this tool was found by opening the image while the suite was green, so a run that reports
  # only "standard MET" is reporting on the half that never catches those.
  #
  # `review --strict` is the gate, and belongs where a human is promoting a run, not here.
  "$PY" -m scprofile.cli review --out "$OUT" || echo "  review exit $?"
fi

_DONE=1
echo "finished : $(date)"
