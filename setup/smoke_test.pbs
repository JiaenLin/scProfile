#!/bin/bash
#PBS -N scprofile_smoke
#PBS -q workq
# 8 cores and 48gb, against `workq`'s ceiling of 50. The fixtures are tiny; the plugin
# SELFTESTS are not - they fit real models in real environments, several sharing one
# node. Estimate high: an over-request costs queue time, and a kill keeps nothing.
#PBS -l select=1:ncpus=8:mem=48gb
#PBS -l walltime=01:00:00
#PBS -j oe

# Prove the whole path on a synthetic dataset: build a fixture, run the kernels over it, merge,
# report. Nothing here touches your data.
#
#   qsub -v TOOL=$HOME/tools/scProfile,OUT=<scratch>,HOST_PYTHON=<python with anndata> \
#        [,PREFIX=<dir holding the kernel envs>] -o <scratch>/smoke.pbs.log  setup/smoke_test.pbs
#
# PREFIX is OPTIONAL. Without it only host-interpreter plugins run, which still walks the plan,
# the decision channel, the per-unit path, the merge and the report - everything that broke on
# 2026-08-26. Give it when you also want the plugins that bring their own environment.
#
# RUN THIS BEFORE A LONG RUN, EVERY TIME. It is minutes on `workq` against hours on `super`, and
# the failure it exists to catch cost three hours of a 64-core allocation and produced two
# refused plugins and no result.
#
# Run this after `install`. A selftest proves a kernel's ENVIRONMENT works; this proves the
# kernel, the contract, the merge and the report work together - which is a different claim, and
# the one that breaks when a kernel starts writing something the host was not expecting.

set -euo pipefail

: "${TOOL:?pass -v TOOL=<path to the scProfile checkout>}"
: "${OUT:?pass -v OUT=<a scratch directory for the results>}"
PREFIX="${PREFIX:-}"

# The HOST needs anndata; it does not need any kernel's pins. Point HOST_PYTHON at an interpreter
# that has anndata, scanpy, numpy and pandas - a kernel env will do if you have nothing else.
HOST="${HOST_PYTHON:-python3}"

mkdir -p "${OUT}"
cd "${TOOL}"

# ONE SMOKE HARNESS, NOT TWO. This script used to build the fixture, run the host and print what
# landed - and CHECK NOTHING, while tests/smoke/run_smoke.sh next door did the same work and then
# asserted the result. Two harnesses for one job is the shape that lets the checked one rot: the
# job that gets submitted is whichever one has a .pbs beside it, and that was this one. It now
# delegates, so submitting it runs the checks.
exec bash tests/smoke/run_smoke.sh "${HOST}" "${OUT}" ${PREFIX:+"${PREFIX}"}
